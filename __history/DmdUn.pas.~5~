procedure TDmdFm.LNotesForThisShipBeforePost(DataSet: TDataSet);
var
  str: string;
  DateValue: TDateTime;
  TimeValue: TTime;
  uuid: string;
begin
  IF (LNotesForThisShipNotes.IsNull) THEN
  BEGIN
    Raise Exception.Create('اكتب نص الملاحظة أولاً');
  END;
  str := DmdFm.Perm.FieldByName('UserName').AsString;

  // Set common fields for both insert and edit
  DmdFm.LNotesForThisShip.FieldByName('Enter_User').AsString := str;
  DmdFm.LNotesForThisShip.FieldByName('Enter_Date').AsDateTime := Now;
  DmdFm.LNotesForThisShip.FieldByName('isUpdated').AsInteger := 1;
  DmdFm.LNotesForThisShip.FieldByName('M_AutoUID').AsString :=
    LsortingtripAutoUID.Value;

  // Check if the dataset is in insert state
  if DataSet.State = dsInsert then
  begin
    try
      // Initialize the query to call the stored procedure
      GetKey.Close;
      GetKey.SQL.Clear;
      GetKey.SQL.Text := 'CALL counting.createNewKey(@new_uuid)';

      // Execute the stored procedure
      GetKey.ExecSQL;

      // Retrieve the value of the output parameter
      GetKey.SQL.Text := 'SELECT @new_uuid AS new_uuid';
      GetKey.Open;

      // Check if the query returned a result
      if not GetKey.IsEmpty then
      begin
        uuid := GetKey.FieldByName('new_uuid').AsString;
        DmdFm.LNotesForThisShip.FieldByName('AutoUID').AsString := uuid;
      end
      else
        uuid := '';

    except
      on E: Exception do
      begin
        // Handle exceptions as needed
        ShowMessage('Error executing stored procedure: ' + E.Message);
      end;
    end;
  end
  else if DataSet.State = dsEdit then
  begin
    str := DmdFm.Perm.FieldByName('UserName').AsString;

    // Set common fields for both insert and edit
    DmdFm.LNotesForThisShip.FieldByName('Enter_User').AsString := str;
    DmdFm.LNotesForThisShip.FieldByName('Enter_Date').AsDateTime := Now;
    DmdFm.LNotesForThisShip.FieldByName('isUpdated').AsInteger := 1;
    DmdFm.LNotesForThisShip.FieldByName('M_AutoUID').AsString :=
      LsortingtripAutoUID.Value;
  end;

end;

