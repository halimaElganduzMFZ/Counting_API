    if LsubmenucounterRF.Value = 0 then
      Raise Exception.Create('!حدد نوع المعاملة هل هي عادية / ثلاجة ');

    if DataSet.State = dsEdit then
    begin
      newValue := Lsubmenucountercondition.Value;
      // ShowMessage(inttostr(newValue)+'---'+inttostr(prevValue));
      if (Lsubmenucountercondition.Value = 1) AND (prevValue <> newValue) then
      begin
        // الحصول على أقصى numAuto
