        Raise Exception.Create('!حدد نوع المعاملة هل هي عادية / ثلاجة ');

    if Flight_MovementFm.conditionTxt.Text <> '1' then
      if (Lsubmenucountercondition.Value = 0) or
        (Lsubmenucountercondition.Value = 2) then
      begin
        // عرض خيار تأكيد للمستخدم - يُفضّل تنفيذ التأكيد قبل استدعاء Post
        case MessageDlg('حالة الحاوية الحالية عجز هل تريد المتابعة',
