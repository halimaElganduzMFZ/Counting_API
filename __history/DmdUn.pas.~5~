          begin
            EHHHHHHHHHHHHHH.First;
            Numm := EHHHHHHHHHHHHHH.FieldByName('MN').AsInteger;
          end
          else
            Numm := 0;
        finally
          EHHHHHHHHHHHHHH.Close;
        end;

        // تعبئة حقول المستخدم والوقت
        str := DmdFm.Perm.FieldByName('UserName').AsString;
        DmdFm.Lsubmenucounter.FieldByName('Enter_User').AsString := str;
        DmdFm.Lsubmenucounter.FieldByName('Enter_Date').AsDateTime := Now;
        DmdFm.Lsubmenucounter.FieldByName('Enter_Time').AsDateTime := Time;
        if TryStrToInt(str, counterNum) then
          DmdFm.LsubmenucounterN_thecounter.Value := counterNum
        else
          DmdFm.LsubmenucounterN_thecounter.Value := 100;
        // DmdFm.Lsubmenucounter.FieldByName('isdataChanged').AsInteger := 1;
        LHrakTemp.Last;
        DmdFm.LsubmenucounterN_Amber.Value := LHrakTempN_Amber.Value;
        DmdFm.LsubmenucounterN_sidewalk.Value := LHrakTempN_sidewalk.Value;
        DmdFm.LsubmenucounterN_bandsupervisor.Value :=
          LHrakTempN_bandsupervisor.Value;
        DmdFm.LsubmenucounterN_crane.Value := LHrakTempN_crane.Value;
        DmdFm.LsubmenucounterN_craneoperator.Value :=
          LHrakTempN_craneoperator.Value;
        // جلب القيم التفصيلية إن وُجد Numm
        if Numm > 0 then
        begin
          SQLText :=
            'SELECT N_Amber, N_sidewalk, N_bandsupervisor, N_crane, N_craneoperator from hraktemp where numAuto= '
            + inttostr(Numm);

          EHHHHHHHHHHHHHH.Close;
          EHHHHHHHHHHHHHH.SQL.Text := SQLText;
          try
            EHHHHHHHHHHHHHH.Open;
            if not EHHHHHHHHHHHHHH.IsEmpty then
            begin
              EHHHHHHHHHHHHHH.First;
              N1 := EHHHHHHHHHHHHHH.FieldByName('N_Amber').AsInteger;
              N2 := EHHHHHHHHHHHHHH.FieldByName('N_sidewalk').AsInteger;
              N3 := EHHHHHHHHHHHHHH.FieldByName('N_bandsupervisor').AsInteger;
              N4 := EHHHHHHHHHHHHHH.FieldByName('N_crane').AsInteger;
              N5 := EHHHHHHHHHHHHHH.FieldByName('N_craneoperator').AsInteger;
              LHrakTemp.Last;
              DmdFm.LsubmenucounterN_Amber.Value := LHrakTempN_Amber.Value;
              DmdFm.LsubmenucounterN_sidewalk.Value :=
                LHrakTempN_sidewalk.Value;
              DmdFm.LsubmenucounterN_bandsupervisor.Value :=
                LHrakTempN_bandsupervisor.Value;
              DmdFm.LsubmenucounterN_crane.Value := LHrakTempN_crane.Value;
              DmdFm.LsubmenucounterN_craneoperator.Value :=
                LHrakTempN_craneoperator.Value;

              ShowMessage('!تم الحفظ');
            end;
          finally
            EHHHHHHHHHHHHHH.Close;
          end;
        end;
      end;

      if Lsubmenucountercondition.Value = 2 then

      begin
        DmdFm.Lsubmenucounter.FieldByName('Enter_User').Clear;
        DmdFm.Lsubmenucounter.FieldByName('Enter_Date').Clear;
        DmdFm.Lsubmenucounter.FieldByName('Enter_Time').Clear;
        DmdFm.LsubmenucounterN_Amber.Clear;
        DmdFm.LsubmenucounterN_sidewalk.Clear;
        DmdFm.LsubmenucounterN_bandsupervisor.Clear;
        DmdFm.LsubmenucounterN_thecounter.Clear;
        DmdFm.LsubmenucounterN_crane.Clear;
        DmdFm.LsubmenucounterN_craneoperator.Clear;

      end;
    end;
  end;
end;

